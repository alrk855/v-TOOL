DASHBOARD_PORT=3000
DATABASE_PATH=/app/data/telemetry.sqlite
DASHBOARD_API_BASE=http://dashboard-service:3000
TZ=Europe/Skopje
RUNNER_CONCURRENCY=4
RUNNER_POLL_INTERVAL_MS=2500
DIAGNOSTIC_ENDPOINT=https://api.ipify.org?format=json
PROXY_ROUTES_JSON=[{"id":"na-us-east-01","server":"http://gw-na-us-east-01.proxy.local:8080","username":"dplt_us_east_7f2a","password":"replace-with-secret-01"},{"id":"eu-de-central-02","server":"http://gw-eu-de-central-02.proxy.local:8080","username":"dplt_de_central_91bc","password":"replace-with-secret-02"},{"id":"ap-jp-tokyo-03","server":"http://gw-ap-jp-tokyo-03.proxy.local:8080","username":"dplt_jp_tokyo_4d88","password":"replace-with-secret-03"}]
SURVEY_OPTION_TEXT=Option Text
SURVEY_OPTION_SELECTOR=
CONFIRMATION_TEXTS=Vote,Submit,Гласај
CONFIRMATION_SELECTOR=

# ── Runner browser mode ─────────────────────────────────────────────────────
# When no PROXY_ROUTES_JSON is set, the runner auto-enables DEV_MODE (visible
# browser, proxy isolation check skipped) so you can test on your direct connection.
# Explicitly set DEV_MODE=false to force proxy enforcement even without routes.
DEV_MODE=

# Uncomment to control an already-open Chrome window instead of launching a new one.
# In local dev, click "Launch Debug Chrome" in the dashboard first, then set this:
# CHROME_CDP_ENDPOINT=http://127.0.0.1:9222
#
# In Docker on Windows, the dashboard container cannot launch your host Chrome.
# If you manually launch Chrome on the host for CDP, Docker usually needs:
# CHROME_CDP_ENDPOINT=http://host.docker.internal:9222

# Set HEADLESS=false to force a visible browser even with proxies configured.
# HEADLESS=false

# Set false to keep execution logs smaller and avoid storing proof screenshots.
SCREENSHOTS_ENABLED=false
